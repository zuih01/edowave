{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Instalar Edowave",
  "version": "0.9.0-beta.68",
  "identifier": "io.empanados.musica.instalador",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Instalar Edowave",
        "width": 560,
        "height": 420,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#0e0e0e"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
