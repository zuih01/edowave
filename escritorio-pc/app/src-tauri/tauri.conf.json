{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Edowave",
  "version": "1.0.3",
  "identifier": "io.empanados.musica",
  "build": {
    "frontendDist": "../../../dist-pc"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Edowave",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "decorations": false,
        "shadow": false,
        "transparent": true,
        "theme": "Dark",
        "backgroundColor": "#00000000",
        "useHttpsScheme": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Edowave",
    "copyright": "Copyright (c) 2026 Edowave",
    "shortDescription": "Edowave: reproductor de música",
    "licenseFile": "aviso-instalador.rtf",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "skip"
      },
      "nsis": {
        "installMode": "perMachine",
        "languages": [
          "Spanish"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "installerHooks": "./instalador.nsh",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "instalador/cabecera.bmp",
        "sidebarImage": "instalador/lateral.bmp",
        "compression": "lzma"
      }
    },
    "homepage": "https://github.com/zuih01/edowave",
    "license": "MIT",
    "category": "Music",
    "longDescription": "Reproductor de música de código abierto con biblioteca compartida en un servidor propio y recomendaciones personales por cuenta."
  }
}
